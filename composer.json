{
	"name": "somehow-digital/craft-mailpit",
	"description": "Mailpit integration for Craft CMS.",
	"type": "craft-plugin",
	"keywords": ["craftcms", "plugin", "mailpit", "email", "development"],
	"license": "MIT",
	"homepage": "https://somehow.digital/",
	"authors": [
		{
			"name": "Thomas Deinhamer",
			"email": "code@thasmo.dev",
			"homepage": "https://thasmo.com/"
		}
	],
	"support": {
		"email": "support@somehow.digital",
		"docs": "https://github.com/somehow-digital/craft-mailpit",
		"source": "https://github.com/somehow-digital/craft-mailpit",
		"issues": "https://github.com/somehow-digital/craft-mailpit/issues"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"craftcms/plugin-installer": true,
			"pestphp/pest-plugin": true,
			"yiisoft/yii2-composer": true
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=1G",
		"ecs": "ecs check",
		"ecs-fix": "ecs check --fix",
		"test": "pest",
		"check": [
			"@ecs",
			"@phpstan",
			"@test"
		]
	},
	"require": {
		"php": "^8.2.0",
		"craftcms/cms": "^5.8.0"
	},
	"require-dev": {
		"craftcms/phpstan": "dev-main",
		"pestphp/pest": "^3.0 || ^4.0",
		"phpstan/phpstan": "^2.1",
		"roave/security-advisories": "dev-latest",
		"symplify/easy-coding-standard": "^13.0"
	},
	"autoload": {
		"psr-4": {
			"SomehowDigital\\Craft\\Mailpit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SomehowDigital\\Craft\\Mailpit\\Tests\\": "tests/"
		}
	},
	"extra": {
		"name": "Mailpit",
		"handle": "mailpit",
		"class": "SomehowDigital\\Craft\\Mailpit\\Mailpit"
	}
}
